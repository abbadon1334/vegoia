{
    // Mutation testing: does the suite notice when the code is wrong?
    //
    // Coverage says which lines ran. That is a weaker question than it looks,
    // and this library has already been caught by the difference -- the JIT
    // guard exercised Leiden, PageRank and least squares, reported that it
    // passed, and missed a defect in Surprise that made it count 105 edges on
    // a 78-edge graph. Lines were covered. Nothing was checked.
    //
    // Infection changes one operator or constant at a time and reruns the
    // tests. A mutant that survives is a change to the library that no
    // assertion objects to, which is either a test worth writing or a line
    // worth deleting.
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "logs": {
        "text": "build/infection/infection.log",
        "summary": "build/infection/summary.log",
        "json": "build/infection/infection.json",
        "stryker": {
            "report": "main"
        }
    },
    "tmpDir": "build/infection/tmp",
    "mutators": {
        "@default": true,

        // The string mutators only ever alter the wording of an exception
        // message: "Correlation needs paired samples" becomes "Correlationneeds
        // paired samples", and the only way to kill that is to assert on the
        // exact text of every message. That trades a brittle test suite for no
        // additional correctness -- the message is not the contract, the
        // exception type and the condition that raises it are, and those are
        // pinned in tests/Unit/ContractTest.php. 48 of the surviving mutants
        // were of this kind.
        "Concat": false,
        "ConcatOperandRemoval": false
    },

    // A few of the numeric kernels run long enough under a mutant that the
    // default 10 seconds expires before they finish, and a mutant that times
    // out is a mutant nobody measured: 335 of them were skipped on the first
    // run for this reason alone.
    "timeout": 30
}
